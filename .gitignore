# OS-generated files
.DS_Store
Thumbs.db

# IDE and editor user state
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo

# Logs and local caches
*.log
.cache/

# Flutter, Dart, and Pub generated files
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
**/doc/api/
**/lcov.info

# Reusable plugin packages should not commit their dependency lock file.
# Keep the example app lock file for reproducible example builds.
/qs_toast/pubspec.lock

# Symbolication and obfuscation output
**/app.*.symbols
**/app.*.map.json
**/*.dSYM/
**/*.dSYM.zip

# FVM SDK symlink (keep .fvmrc tracked)
**/.fvm/flutter_sdk

# Android generated and machine-local files
**/android/.gradle/
**/android/.cxx/
**/android/local.properties
**/android/captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/**/GeneratedPluginRegistrant.java

# Android signing secrets
**/android/key.properties
**/*.keystore
**/*.jks

# iOS generated files and user state
**/ios/Pods/
**/ios/.symlinks/
**/ios/DerivedData/
**/ios/**/xcuserdata/
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/flutter_assets/
**/ios/**/GeneratedPluginRegistrant.h
**/ios/**/GeneratedPluginRegistrant.m
**/*.ipa
**/*.xcarchive/

# Xcode per-user files
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3
!default.mode1v3
!default.mode2v3
!default.pbxuser
